// ReadBox of the editor (EditorWorld): the variant id of every block of a box in world cells, ~0 outside the ring or not in memory, 0 for air and object parts.
layout(local_size_x = GROUP_X) in;
#include "world.glsli"
#include "camera.glsli"
#include "blocks.glsli"
#include "models.glsli"
#include "rays.glsli"
layout(set = 0, binding = 2, std430) restrict writeonly buffer Ids { uint ids[]; };
layout(push_constant, std430) uniform PC { ivec4 lo; ivec4 size; } pc; // lo: world block; size.w: invocations per dispatch row

void main() {
	uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * uint(pc.size.w);
	ivec3 s = pc.size.xyz;
	if (i >= uint(s.x * s.y * s.z)) return;
	r_off = -W.ring.min.xyz * CHUNK;
	r_lo = -r_off;
	r_hi = r_lo + W.ring.size.xyz * CHUNK;
	ivec3 cell = pc.lo.xyz + ivec3(int(i) % s.x, int(i) / s.x % s.y, int(i) / (s.x * s.y)), lo, hi;
	if (any(lessThan(cell, r_lo)) || any(greaterThanEqual(cell, r_hi))) { ids[i] = ~0u; return; }
	uint w = lookup(cell, lo, hi);
	ids[i] = w == MISSING ? ~0u : w >= PART ? 0u : w & PAL_ID_MASK;
}
