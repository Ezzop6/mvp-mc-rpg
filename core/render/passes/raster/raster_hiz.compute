// Raster/meshes: depth pyramid for raster_cull.compute, one dispatch per mip: farthest (reverse Z: smallest) of 2x2, edge texels repeat.
layout(local_size_x = GROUP_X, local_size_y = GROUP_Y) in;

layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, r32f) uniform restrict writeonly image2D dst;

void main() {
	ivec2 p = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(p, imageSize(dst)))) return;
	ivec2 s = textureSize(src, 0) - 1, q = p * 2;
	float d = min(min(texelFetch(src, min(q, s), 0).r, texelFetch(src, min(q + ivec2(1, 0), s), 0).r),
		min(texelFetch(src, min(q + ivec2(0, 1), s), 0).r, texelFetch(src, min(q + 1, s), 0).r));
	imageStore(dst, p, vec4(d));
}
