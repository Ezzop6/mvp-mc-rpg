layout(local_size_x = GROUP_X, local_size_y = GROUP_Y) in;

layout(set = 0, binding = 0, std430) restrict buffer Tex { uint texels[]; };
layout(set = 0, binding = 1, std430) restrict readonly buffer Anim { uvec4 anim[]; };

void main() {
	uint i = gl_GlobalInvocationID.x;
	if (i >= uint(TEXELS_PER_LAYER)) return;
	uvec4 a = anim[gl_GlobalInvocationID.y];
	float blend = uintBitsToFloat(a.w);
	vec4 c = unpackUnorm4x8(texels[a.y * uint(TEXELS_PER_LAYER) + i]);
	if (blend > 0.0) c = mix(c, unpackUnorm4x8(texels[a.z * uint(TEXELS_PER_LAYER) + i]), blend);
	texels[a.x * uint(TEXELS_PER_LAYER) + i] = packUnorm4x8(c);
}
