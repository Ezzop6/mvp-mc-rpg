// v1 stars: area-weighted cube cells hold at most one star, a Gaussian of radius StarSize widened by the pixel, keeping its flux.
vec3 qrot(vec4 q, vec3 v) { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }

vec3 stars_cells(vec3 c, vec3 d, bool sky) {
	float fade = smoothstep(0.0, P.star_fade, -P.sky_sun.y);
	if (!sky || fade <= 0.0) return c;
	vec3 s = qrot(P.sky_rot, d), a = abs(s);
	float m = max(a.x, max(a.y, a.z)), face = a.x == m ? (s.x > 0.0 ? 0.0 : 1.0) : a.y == m ? (s.y > 0.0 ? 2.0 : 3.0) : (s.z > 0.0 ? 4.0 : 5.0);
	vec2 fuv = (a.x == m ? s.yz : a.y == m ? s.zx : s.xy) / m;
	float g = max(ceil(sqrt(P.star_count / 1.57)), 1.0);
	vec2 cell = floor((fuv * 0.5 + 0.5) * g), key = cell + vec2(face * g, 0.0), cc = (cell + 0.5) / g * 2.0 - 1.0;
	float p = P.star_count / (3.1416 * g * g) * pow(inversesqrt(1.0 + dot(cc, cc)), 3.0), h = sky_hash(key);
	if (h >= p) return c;
	vec2 sc = (cell + 0.1 + 0.8 * vec2(sky_hash(key + 17.17), sky_hash(key + 31.31))) / g * 2.0 - 1.0;
	float ang = length(cross(normalize(vec3(fuv, 1.0)), normalize(vec3(sc, 1.0))));
	float r = radians(P.star_size), w2 = r * r + 0.25 * cam.lens.x * cam.lens.x;
	float b = pow(h / p, 6.0) * (1.0 + P.star_twinkle * sin(P.sky_sun.w * P.star_twinkle_speed + h * 600.0));
	return c + vec3(fade * P.star_brightness * b * r * r / w2 * exp(-0.5 * ang * ang / w2)) * above_horizon(d);
}
