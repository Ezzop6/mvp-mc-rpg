int face_code(int axis, bool positive) { return axis * 2 + (positive ? 1 : 0); }
const uint NORMAL_SKY = 7u;

ivec3 face_step(int code) { ivec3 s = ivec3(0); s[code >> 1] = (code & 1) != 0 ? 1 : -1; return s; }
vec3 face_normal(uint code) { return vec3(face_step(int(code))); }

// u, v axes of a face on `axis`: cyclic, so u x v points along +axis.
ivec2 face_axes(int axis) { return ivec2((axis + 1) % 3, (axis + 2) % 3); }
