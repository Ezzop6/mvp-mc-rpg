// Micro-voxel model library (layout: docs/world-format.md, GPU), packed by ModelStore.cs; after world.glsli, blocks.glsli.
layout(set = WORLD_SET, binding = WB_MODEL_DATA, std430) restrict readonly buffer ModelData { uint mdata[]; };

// Dropped item (docs/world-format.md, GPU): pos = bottom centre, yaw; lo, hi = world box, w = cos, sin of the yaw.
struct Item { vec4 pos_yaw; uint model, state, fall_speed, pad; vec4 lo; vec4 hi; };
layout(set = WORLD_SET, binding = WB_ITEMS, std430) restrict buffer Items {
	uint item_count, item_pad0, item_pad1, item_pad2;
	vec4 items_lo;     // box around all items
	vec4 items_hi;
	Item items[];
};

// x = cells x | y << 8 | z << 16 | voxel width << 24, y = first material, z = first cell table entry, w = size x | z << 16 (voxels)
uvec4 model_rec(uint m) { uint o = mdata[MH_RECORDS] + m * MODEL_REC_WORDS; return uvec4(mdata[o], mdata[o + 1u], mdata[o + 2u], mdata[o + 3u]); }
ivec3 model_cells(uvec4 r) { return ivec3(r.x & 0xFFu, (r.x >> 8) & 0xFFu, (r.x >> 16) & 0xFFu); }
vec2 model_half_xz(uvec4 r) { return vec2(float(r.w & 0xFFFFu), float(r.w >> 16)) / (2.0 * float(MICRO)); }

uint model_cell(uvec4 r, ivec3 c) {
	ivec3 n = model_cells(r);
	return mdata[mdata[MH_CELLS] + r.z + uint(c.x + n.x * (c.y + n.y * c.z))];
}

// Element i of a pool array of `width`-byte values starting at word `base`.
uint pool_value(uint base, uint width, uint i) {
	uint b = i * width;
	return (mdata[base + (b >> 2)] >> ((b & 3u) * 8u)) & (width == 1u ? 0xFFu : 0xFFFFu);
}

// Palette value of voxel v of a cell at mip L (32 >> L per axis) and the box [lo, hi) it stands for (empty brick = one box).
uint cell_voxel(uint cell, uint width, int L, ivec3 v, out ivec3 lo, out ivec3 hi) {
	uint pool = MH_POOLS + POOL_STRIDE * (width - 1u);
	lo = v; hi = v + 1;
	if (L >= 3) return pool_value(mdata[pool + POOL_CELL_TAILS], width, cell * TAIL_VALUES + (L == 4 ? TAIL_VALUES - 1u : uint(v.x + 4 * (v.y + 4 * v.z))));
	int per_axis = 4 >> L;
	ivec3 b = v >> 3;
	uint brick = mdata[mdata[pool + POOL_CELL_REFS] + cell * BRICK_REFS + (L == 0 ? 0u : L == 1 ? MIP1_REF : MIP2_REF) + uint(b.x + per_axis * (b.y + per_axis * b.z))];
	if (brick == EMPTY_REF) { lo = b * 8; hi = lo + 8; return 0u; }
	return pool_value(mdata[pool + POOL_BRICKS], width, brick * BRICK_VOXELS + uint((v.x & 7) + 8 * ((v.y & 7) + 8 * (v.z & 7))));
}

// x = sRGB rgba, y = half emission rg, z = half emission b | roughness, w = half metallic | tinted
uvec4 material(uint m) { uint o = mdata[MH_MATERIALS] + m * MATERIAL_WORDS; return uvec4(mdata[o], mdata[o + 1u], mdata[o + 2u], mdata[o + 3u]); }
vec3 material_albedo(uint m) { return to_linear(unpackUnorm4x8(material(m).x).rgb); }
vec3 material_emission(uint m) { uvec4 v = material(m); return vec3(unpackHalf2x16(v.y), unpackHalf2x16(v.z).x); }
bool material_tinted(uint m) { return unpackHalf2x16(material(m).w).y > 0.5; }
float material_alpha(uint m) { return unpackUnorm4x8(material(m).x).a; } // < 1: a translucent voxel (stained glass panes)

#ifdef SEE_THROUGH
uint see_mat; // march_model: the first translucent voxel it passed (rays.glsli), its distance and face
float see_th;
int see_ax;
#endif

// Palette value of model voxel v (level L, n per cell) and its box [lo, hi): an empty cell or brick is one box.
uint model_voxel(uvec4 rec, int L, int n, ivec3 v, out ivec3 lo, out ivec3 hi) {
	ivec3 c = v >> (5 - L);
	uint mc = model_cell(rec, c);
	if (mc == EMPTY_REF) { lo = c * n; hi = lo + n; return 0u; }
	uint val = cell_voxel(mc, rec.x >> 24, L, v - c * n, lo, hi);
	lo += c * n; hi += c * n;
	return val;
}

// First solid voxel along o + d t, t in [t0, t1) in model space, 0 = none; ax = hit face code; skip: leaving a surface.
uint march_model(uvec4 rec, vec3 o, vec3 d, float t0, float t1, int entry, int L, bool skip, out float th, out int ax, out int s) {
	int n = MICRO >> L;
	ivec3 size = model_cells(rec) * n, fwd = ivec3(greaterThan(d, vec3(0.0)));
	vec3 po = o * float(n), dv = d * float(n), inv = 1.0 / dv;
	ivec3 v = clamp(ivec3(floor(po + dv * (t0 + 1e-4))), ivec3(0), size - 1);
	float t = t0;
	ax = entry;
	for (s = 0; s < 256; s++) {
		ivec3 lo, hi;
		uint val = model_voxel(rec, L, n, v, lo, hi);
#ifdef SEE_THROUGH
		if (val != 0u && !skip && material_alpha(rec.y + val) < 0.999) {
			if (see_mat == 0u) { see_mat = rec.y + val; see_th = t; see_ax = face_code(ax, fwd[ax] == 0); }
		} else
#endif
		if (val != 0u && !skip) { th = t; ax = face_code(ax, fwd[ax] == 0); return val; }
		skip = skip && val != 0u;
		vec3 te = (vec3(lo + fwd * (hi - lo)) - po) * inv;
		float tx = min(min(te.x, te.y), te.z);
		int a = te.x == tx ? 0 : te.y == tx ? 1 : 2;
		if (tx >= t1) return 0u;
		ivec3 next = clamp(ivec3(floor(po + dv * tx)), lo, hi - 1);
		next[a] = fwd[a] != 0 ? hi[a] : lo[a] - 1;
		if (next[a] < 0 || next[a] >= size[a]) return 0u;
		t = tx; ax = a; v = next;
	}
	return 0u;
}

vec3 yaw_rotate(vec3 v, float c, float s) { return vec3(c * v.x - s * v.z, v.y, s * v.x + c * v.z); }
// Model axis i -> world axis rot_perm(r)[i] with sign rot_signs(r)[i] (Rotation24, docs/world-format.md).
ivec3 rot_perm(uint r) {
	int k = int(r >> 2);
	return k < 3 ? ivec3(k, k + 1, k + 2) % 3 : ivec3(k, k + 2, k + 1) % 3;
}
ivec3 rot_signs(uint r) {
	int s0 = (r & 1u) != 0u ? -1 : 1, s1 = (r & 2u) != 0u ? -1 : 1;
	return ivec3(s0, s1, (r >> 2) < 3u ? s0 * s1 : -s0 * s1);
}

// Rows: model axis i = sign i * world axis perm i.
mat3 rot_world_to_model(uint r) {
	ivec3 p = rot_perm(r), s = rot_signs(r);
	return transpose(mat3(vec3(equal(ivec3(p.x), ivec3(0, 1, 2))) * float(s.x), vec3(equal(ivec3(p.y), ivec3(0, 1, 2))) * float(s.y),
		vec3(equal(ivec3(p.z), ivec3(0, 1, 2))) * float(s.z)));
}

uint obj_model(ivec4 f) { return uint(f.w >> 8) & 0xFFFFu; }
uint obj_rot(ivec4 f) { return uint(f.w >> 24) & 31u; }

// Rotated footprint (blocks) and its min corner: centred on the anchor, standing on the surface block.
ivec3 obj_dims(ivec4 f) {
	ivec3 d = model_cells(model_rec(obj_model(f))), p = rot_perm(obj_rot(f)), w;
	w[p.x] = d.x; w[p.y] = d.y; w[p.z] = d.z;
	return w;
}
ivec3 obj_origin(ivec4 f, ivec3 dims) { return ivec3(f.x - dims.x / 2, f.y + 1, f.z - dims.z / 2); }

// Model cell under world block b of a grid object, or EMPTY_REF.
uint obj_cell_at(ivec4 f, ivec3 b) {
	ivec3 wd = obj_dims(f), d = b - obj_origin(f, wd);
	if (any(lessThan(d, ivec3(0))) || any(greaterThanEqual(d, wd))) return EMPTY_REF;
	uint r = obj_rot(f);
	ivec3 p = rot_perm(r), s = rot_signs(r), m;
	uvec4 rec = model_rec(obj_model(f));
	ivec3 dims = model_cells(rec);
	for (int i = 0; i < 3; i++) m[i] = s[i] > 0 ? d[p[i]] : dims[i] - 1 - d[p[i]];
	return model_cell(rec, m);
}

// One of the variant's weighted looks by the world block's hash.
uint block_look(uint v, ivec3 b) {
	uint n = types[v].looks, total = types[v].face[n - 1u] >> LOOK_WEIGHT_SHIFT, k = 0u;
	uint r = block_hash(b) % total;
	while (k + 1u < n && r >= types[v].face[k] >> LOOK_WEIGHT_SHIFT) k++;
	return types[v].face[k];
}
