// World data in set 1 (layout: docs/v2.md §3.3): directory, chunk records, brick pools, occupancy.
#include "faces.glsli"

layout(set = WORLD_SET, binding = WB_DIR, std430) restrict buffer Dir { uvec2 dir[]; };           // per ring slot: NONE, UNI | block + fluid, or record index
layout(set = WORLD_SET, binding = WB_RECORDS, std430) restrict buffer Records { uint records[]; }; // CHUNK_REC_WORDS per chunk: GROUPS_PER_CHUNK group entries (uvec2), the stamp
layout(set = WORLD_SET, binding = WB_BRICK4, std430) restrict buffer Brick4 { uint brick4[]; };
layout(set = WORLD_SET, binding = WB_BRICK16, std430) restrict buffer Brick16 { uint brick16[]; };
layout(set = WORLD_SET, binding = WB_BRICK_FULL, std430) restrict buffer BrickFull { uint brick_full[]; };
layout(set = WORLD_SET, binding = WB_OCCUPANCY, std430) restrict buffer Occupancy { uint occ[]; };    // bit per ring slot: not only air
layout(set = WORLD_SET, binding = WB_OCCUPANCY_MIP, std430) restrict buffer OccupancyMip { uint occ_mip[]; }; // bit per 4^3 slots
layout(set = WORLD_SET, binding = WB_VISIBLE, std430) restrict buffer Visible { uint vis_bits[]; }; // bit per slot: a sampled primary ray hit or wanted (missing) the chunk since the last readback (World.ApplyVisible)
// The ring: min = world chunk of its first slot row, size = D (w = slots), off = pmod(min, D) (w = wanted radius, chunks).
struct Ring { ivec4 min; ivec4 size; ivec4 off; };
layout(set = WORLD_SET, binding = WB_WORLD, std430) restrict buffer World {
	vec4 near;       // PROBE: xyz = camera chunk, w = NearRadius in chunks
	uvec4 probe;     // NONE chunks within x = near.w, y = w (mid radius, chunks); z = entries generated over a resident one; cleared every frame
	ivec4 rows;      // xy = the generator's chunk rows [x, y)
	Ring ring;
	uint used[4];    // by PL_*: bump high water (FIXUP clamps it to cap)
	uint cap[4];
	uint fail[4];    // chunks that did not fit
	int free_top[4]; // free stack heights; failed pops take them below 0 until FIXUP
	int top_y;       // 1 + highest occupied world chunk y since the reset (only grows), ring.min.y = none
	uint stat[3];    // x = column features dropped (MAX_COL_FEATURES)
	int perm[PERM_SIZE];
} W;

const uint MISSING = 0xFFFFFFFFu; // lookup of a NONE chunk
int pmod(int a, int m) { return a >= 0 ? a % m : m - 1 - (-a - 1) % m; } // GLSL % is undefined for negative operands
int fdiv(int a, int b) { return a >= 0 ? a / b : -((-a - 1) / b) - 1; }

int group_index(ivec3 g) { return g.x + GROUPS_PER_AXIS * (g.y + GROUPS_PER_AXIS * g.z); } // a group of the chunk, g in groups
ivec3 group_coord(int i) { return ivec3(i % GROUPS_PER_AXIS, (i / GROUPS_PER_AXIS) % GROUPS_PER_AXIS, i / (GROUPS_PER_AXIS * GROUPS_PER_AXIS)); }
int cell_index(ivec3 c) { return c.x + GROUP * (c.y + GROUP * c.z); } // a cell of the group
ivec3 cell_coord(int i) { return ivec3(i % GROUP, (i / GROUP) % GROUP, i / (GROUP * GROUP)); }

// Air box, 4 bits per value in bits 8-31: cells of a group ([lo, hi) in the brick's box word) or groups of the chunk (extent around an air group entry).
uint pack_box(uvec3 lo, uvec3 hi) { return (lo.x | lo.y << 4 | lo.z << 8 | hi.x << 12 | hi.y << 16 | hi.z << 20) << 8; }
uvec3 box_lo(uint w) { uint b = w >> 8; return uvec3(b, b >> 4, b >> 8) & 15u; }
uvec3 box_hi(uint w) { uint b = w >> 8; return uvec3(b >> 12, b >> 16, b >> 20) & 15u; }

// Ring slot of a world chunk, as coordinates and as one index.
ivec3 ring_size() { return W.ring.size.xyz; }
ivec3 slot_of(ivec3 wc) { ivec3 d = ring_size(); return ivec3(pmod(wc.x, d.x), pmod(wc.y, d.y), pmod(wc.z, d.z)); }
uint slot_index(ivec3 s) { ivec3 d = ring_size(); return uint(s.x + d.x * (s.y + d.y * s.z)); }
uint chunk_slot(ivec3 wc) { return slot_index(slot_of(wc)); }
uint mip_index(ivec3 s) { ivec3 m = s >> 2, md = ring_size() >> 2; return uint(m.x + md.x * (m.y + md.y * m.z)); }
bool bit_of(uint w, uint i) { return (w >> (i & 31u) & 1u) != 0u; }

const uint ENTRY_AIR = CLASS_AIR << CLASS_SHIFT;
uint entry_class(uint x) { return x >> CLASS_SHIFT; }

uint brick_word(uint cls, uint i) { return cls == 0u ? brick4[i] : cls == 1u ? brick16[i] : brick_full[i]; }
uint brick_base(uint cls, uint b) { return b * (cls == 0u ? BRICK4_WORDS : cls == 1u ? BRICK16_WORDS : BRICK_FULL_WORDS); }
uint brick_index(uint cls, uint base, uint v) { return (brick_word(cls, base + (v >> 2)) >> ((v & 3u) * 8u)) & 0xFFu; }
uvec2 brick_pair(uint cls, uint base, uint i) { uint o = base + BRICK_INDEX_WORDS + 2u * i; return uvec2(brick_word(cls, o), brick_word(cls, o + 1u)); }

uint pal_flags(uint w) { return w >> PAL_FLAG_SHIFT; }
