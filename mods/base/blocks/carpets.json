    {
      "id": "base:pale_moss_carpet",
      "kind": "carpet",
      "template": "carpet",
      "textures": { "particle": "block/pale_moss_carpet", "wool": "block/pale_moss_carpet" },
      "states": {
        "bottom": ["false", "true"],
        "east": ["none", "low", "tall"],
        "north": ["none", "low", "tall"],
        "south": ["none", "low", "tall"],
        "west": ["none", "low", "tall"]
      },
      "multipart": [
        { "when": [{ "bottom": "true" }], "looks": [{ "model": "pale_moss_carpet" }] },
        { "when": [{ "bottom": "false", "east": "none", "north": "none", "south": "none", "west": "none" }], "looks": [{ "model": "pale_moss_carpet" }] },
        { "when": [{ "north": "tall" }], "looks": [{ "model": "pale_moss_carpet_side_tall" }] },
        { "when": [{ "north": "low" }], "looks": [{ "model": "pale_moss_carpet_side_small" }] },
        {
          "when": [{ "bottom": "false", "east": "none", "north": "none", "south": "none", "west": "none" }],
          "looks": [{ "model": "pale_moss_carpet_side_tall" }]
        },
        { "when": [{ "east": "tall" }], "looks": [{ "model": "pale_moss_carpet_side_tall", "y": 90, "uvlock": true }] },
        { "when": [{ "east": "low" }], "looks": [{ "model": "pale_moss_carpet_side_small", "y": 90, "uvlock": true }] },
        {
          "when": [{ "bottom": "false", "east": "none", "north": "none", "south": "none", "west": "none" }],
          "looks": [{ "model": "pale_moss_carpet_side_tall", "y": 90, "uvlock": true }]
        },
        { "when": [{ "south": "tall" }], "looks": [{ "model": "pale_moss_carpet_side_tall", "y": 180, "uvlock": true }] },
        { "when": [{ "south": "low" }], "looks": [{ "model": "pale_moss_carpet_side_small", "y": 180, "uvlock": true }] },
        {
          "when": [{ "bottom": "false", "east": "none", "north": "none", "south": "none", "west": "none" }],
          "looks": [{ "model": "pale_moss_carpet_side_tall", "y": 180, "uvlock": true }]
        },
        { "when": [{ "west": "tall" }], "looks": [{ "model": "pale_moss_carpet_side_tall", "y": 270, "uvlock": true }] },
        { "when": [{ "west": "low" }], "looks": [{ "model": "pale_moss_carpet_side_small", "y": 270, "uvlock": true }] },
        {
          "when": [{ "bottom": "false", "east": "none", "north": "none", "south": "none", "west": "none" }],
          "looks": [{ "model": "pale_moss_carpet_side_tall", "y": 270, "uvlock": true }]
        }
      ]
    },
